{
  "kind": "collectionType",
  "collectionName": "doctors",
  "info": {
    "singularName": "doctor",
    "pluralName": "doctors",
    "displayName": "doctor"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "speciality": {
      "type": "string"
    },
    "info": {
      "type": "richtext"
    },
    "image": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "metaDescription": {
      "type": "text"
    },
    "fee": {
      "type": "integer"
    },
    "degree": {
      "type": "string"
    },
    "experience": {
      "type": "string"
    },
    "listing": {
      "type": "boolean"
    },
    "institutes": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::institute.institute",
      "inversedBy": "doctors"
    },
    "locationName": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::location-name.location-name"
    }
  }
}
